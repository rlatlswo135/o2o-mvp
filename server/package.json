{
  "name": "@server",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "check:fix": "vp check --fix",
    "format:fix": "vp fmt . --write",
    "lint:fix": "vp lint --fix --format=agent",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:db": "docker start o2o-dev-db 2>/dev/null || docker run -d --name o2o-dev-db --env-file .env -p 127.0.0.1:5432:5432 -v o2o-dev-db-data:/var/lib/postgresql/data postgres:17-alpine",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vp test --project unit",
    "test:watch": "vp test watch --project unit",
    "test:cov": "vp test --project unit --coverage",
    "test:debug": "vp test --project unit --inspect-brk --no-file-parallelism",
    "test:e2e": "vp test --project e2e"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/drizzle": "^0.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "add": "^2.0.9",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "pg": "^8.23.1",
    "pnpm": "^12.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "dotenv": "^18.0.6",
    "drizzle-kit": "1.0.0-rc.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.0",
    "vite-plus": "catalog:"
  }
}
